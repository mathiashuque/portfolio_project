{
  "name": "portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run test && npm run build",
    "deploy": "npm run verify && npx vercel --prod",
    "audit:high": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/agents": "^0.4.10",
    "@upstash/redis": "^1.36.2",
    "lucide-react": "^0.563.0",
    "motion": "^12.33.0",
    "next": "16.3.5",
    "next-intl": "^4.8.3",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.1",
    "tailwindcss-animated": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@humanfs/node": "0.16.8",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "qs": "6.16.0",
    "next": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.11": true,
    "unrs-resolver@1.12.2": true
  }
}
